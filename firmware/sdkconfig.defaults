# --- Target chip ---
CONFIG_IDF_TARGET="esp32c3"
# Note: ESP32-C3 has no PSRAM, so CONFIG_SPIRAM is not set.

# --- Flash ---
# The current FoloToy AI Passport product/firmware baseline uses 8MB Flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Fix the image header at 8MB and disable detect, to make idf.py merge-bin work.
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# The default template keeps only NVS, PHY data and a factory app that takes the remaining space; change as needed.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Console: USB-Serial-JTAG (C3 native USB, GPIO18/19) ---
# UART0 is not used: its default TX=GPIO21 conflicts with this board's backlight pin.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL built-in malloc pool size (KB). It is a separate static region not shared with the system heap, so setting it too large wastes RAM.
# This demo UI is simple and 24KB is enough; if a complex custom UI hangs while drawing or trips the watchdog, increase this value.
CONFIG_LV_MEM_SIZE_KILOBYTES=36
# Fresh-config builds resolved this to empty, which breaks LVGL includes;
# keep it aligned with the tracked sdkconfig value.
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_QRCODE=y

# --- System ---
CONFIG_FREERTOS_HZ=1000
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set

# Keep the accepted 20 KiB receive window within this no-PSRAM board's budget.
# The 30 fps profile retains the existing send buffer, mailbox and Wi-Fi buffers;
# it does not enlarge the application video buffer.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=20480
CONFIG_LWIP_TCP_RECVMBOX_SIZE=48
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=48
# Report received out-of-order segments so the TV sender can recover missing
# data selectively. Keep the existing bounded receive buffers on this no-PSRAM board.
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_STATS=y
# components/passport_tv/tv_lwip_receive.lf places only the measured receive/ACK path in IRAM.
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set

# The standalone host reserves TV's 10 KiB video ring. Together with the
# upstream six static RX buffers, this funds Wi-Fi's common IRAM fast path.
# RX-only IRAM was slower in the device comparison; retain the common fast path.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# Standalone TV does not start Bluetooth.
# CONFIG_BT_ENABLED is not set

CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP=y

# Pairing may use an HTTPS provisioning origin.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
